<%- include('../partials/head', {
  pageTitle: course.name + ' at ' + club.name + ' — Scorecard & Course Details',
  pageDescription: pageDescription
}) %>

<%
  function fmtDate(d, opts) { return new Date(d).toLocaleDateString('en-GB', opts || { weekday: 'short', day: 'numeric', month: 'short', year: 'numeric' }); }
  function cap(s) { return s ? s.charAt(0).toUpperCase() + s.slice(1) : s; }
%>

<nav class="breadcrumb">
  <a href="/clubs">Clubs</a> /
  <% if (countySlug) { %><a href="/county/<%= countySlug %>"><%= club.county %></a> / <% } %>
  <a href="/clubs/<%= club.slug %>"><%= club.name %></a> /
  <span><%= course.name %></span>
</nav>

<% if (club.archived_at) { %>
  <p class="error-message">This club is no longer listed on Wales Junior Golf.</p>
<% } %>

<h1><%= course.name %></h1>
<p class="subtitle">at <a href="/clubs/<%= club.slug %>"><%= club.name %></a><% if (club.county) { %> · <%= club.county %><% } %><% if (club.address) { %> · <%= club.address %><% } %></p>

<div class="club-actions">
  <a class="club-action primary" href="/clubs/<%= club.slug %>">Club details &amp; contact</a>
  <% if (club.directions_url) { %><a class="club-action" href="<%= club.directions_url %>" target="_blank" rel="noopener">Get directions</a><% } %>
  <% if (course.has_card) { %><a class="club-action" href="#scorecard">Scorecard</a><% } %>
</div>

<div class="event-detail-grid">
  <div>
    <% if (course.description) { %>
      <div class="detail-card">
        <h3 class="detail-card-heading">About the course</h3>
        <p class="club-description"><%= course.description %></p>
      </div>
    <% } %>

    <div class="detail-card">
      <h3 class="detail-card-heading">At a glance</h3>
      <% if (course.holes || course.par || course.yardage) { %>
        <table class="details-table">
          <% if (course.holes) { %><tr><td>Holes</td><td><%= course.holes %><% if (course.holes === 9) { %> <span class="badge badge-nine">9-hole course</span><% } %></td></tr><% } %>
          <% if (course.par_display) { %><tr><td>Par</td><td><%- course.par_display %></td></tr><% } %>
          <% if (course.yardage_display) { %><tr><td>Length</td><td><%- course.yardage_display %><% if (course.tees.length && course.holes !== 9) { %> <span class="muted">(<%= course.tees[0].tee %> tees)</span><% } %></td></tr><% } %>
          <% if (course.tees.length > 1) { %>
            <tr><td>Tees</td><td>
              <ul class="tee-list">
                <% course.tees.forEach(function(t) { %><li><span class="tee-dot tee-dot-<%= t.tee %>"></span><%= cap(t.tee) %> · <%= t.yards.toLocaleString('en-GB') %> yds</li><% }); %>
              </ul>
            </td></tr>
          <% } %>
        </table>
      <% } else { %>
        <p class="muted">Course details aren't available yet.</p>
      <% } %>
    </div>

    <% if (events.length) { %>
      <div class="detail-card">
        <h3 class="detail-card-heading">Upcoming junior events on this course</h3>
        <ul class="club-event-list">
          <% events.forEach(function(e) { %>
            <li>
              <a href="/events/<%= e.slug %>" class="club-event">
                <span class="club-event-date">
                  <span class="club-event-day"><%= new Date(e.date_start).getDate() %></span>
                  <span class="club-event-month"><%= fmtDate(e.date_start, { month: 'short', year: '2-digit' }) %></span>
                </span>
                <span class="club-event-body">
                  <strong><%= e.title %></strong>
                  <span class="muted small"><%= fmtDate(e.date_start) %><% if (e.age_category) { %> · <%= e.age_category %><% } %><% if (e.entry_fee) { %> · £<%= e.entry_fee %><% } %></span>
                </span>
              </a>
            </li>
          <% }); %>
        </ul>
      </div>
    <% } %>
  </div>

  <div>
    <div class="detail-card">
      <h3 class="detail-card-heading">Other courses at <%= club.name %></h3>
      <ul class="course-list">
        <% otherCourses.forEach(function(co) { %>
          <li>
            <a href="<%= co.url %>" class="course-item">
              <span class="course-item-name"><%= co.name %><% if (co.holes === 9) { %> <span class="badge badge-nine">9 holes</span><% } %></span>
              <span class="muted small"><%= co.summary || 'Details coming soon' %></span>
            </a>
          </li>
        <% }); %>
      </ul>
    </div>
  </div>
</div>

<% if (course.has_card) { %>
  <div id="scorecard">
    <%- include('../partials/scorecard', { scorecard: course.scorecard, scorecardNote: course.name + ' scorecard' }) %>
  </div>
<% } %>

<script type="application/ld+json"><%- jsonLd %></script>

<%- include('../partials/foot') %>
