<%- include('../partials/head', { pageTitle: 'Admin — Submissions' }) %>

<h1>Submissions</h1>
<% if (typeof removed !== 'undefined' && removed) { %><p class="success-message">Event removed. The submission is back in the queue.</p><% } %>
<p><a href="/admin">&larr; Dashboard</a></p>

<% if (submissions.length === 0) { %>
  <p>No submissions yet.</p>
<% } %>

<% submissions.forEach(function(s) { %>
  <div class="detail-card">
    <p><strong><%= s.raw_data.event_title %></strong> — <%= s.raw_data.club_name %></p>
    <p class="course-address">
      Date: <%= s.raw_data.event_date %> ·
      Fee: <%= s.raw_data.entry_fee || 'not given' %> ·
      From: <%= s.submitted_by_email %> ·
      <span class="status-pill status-<%= s.status %>"><%= s.status %></span>
    </p>
    <% if (s.raw_data.entry_info) { %><p>How to enter: <%= s.raw_data.entry_info %></p><% } %>
    <% if (s.raw_data.notes) { %><p>Notes: <%= s.raw_data.notes %></p><% } %>
    <p class="course-address">Submitted <%= new Date(s.created_at).toLocaleDateString('en-GB') %></p>

    <% if (s.linked_event_id) { %>
      <p>Event created: <a href="/admin/events/<%= s.linked_event_id %>/edit"><%= s.event_title %></a></p>
      <form method="post" action="/admin/submissions/<%= s.id %>/remove-event" style="display:inline"
            onsubmit="return confirm('Delete this event from the site and put the submission back in the queue?')">
        <button type="submit" class="admin-delete-button">Remove event</button>
      </form>
    <% } else if (s.status !== 'rejected') { %>
      <a class="admin-button" href="/admin/events/new?submission=<%= s.id %>">Create event</a>
      <% if (s.status === 'pending') { %>
        <form method="post" action="/admin/submissions/<%= s.id %>/status" style="display:inline">
          <input type="hidden" name="status" value="rejected">
          <button type="submit" class="admin-delete-button">Reject</button>
        </form>
      <% } else { %>
        <p class="scorecard-note">Approved earlier, but no event was created from it.</p>
      <% } %>
    <% } %>
  </div>
<% }); %>

<%- include('../partials/foot') %>
