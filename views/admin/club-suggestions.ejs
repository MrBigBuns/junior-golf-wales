<%- include('../partials/head', { pageTitle: 'Admin — Club suggestions' }) %>

<h1>Club suggestions</h1>
<p><a href="/admin">&larr; Dashboard</a></p>

<div class="detail-card suggestion-tools">
  <h3 class="detail-card-heading">Fill gaps in a spreadsheet</h3>
  <p class="course-address">Export every club (proposed values where pending, otherwise live values), fill in or correct cells in Excel, then import. Changed cells become pending suggestions marked <em>your edit</em> for review below. Blank cells are ignored and never clear data. Leave the <code>id</code> column alone.</p>
  <p>
    <a class="admin-button" href="/admin/club-suggestions/export.csv?region=South">Export South</a>
    <a class="admin-button" href="/admin/club-suggestions/export.csv">Export all regions</a>
  </p>
  <form method="post" action="/admin/club-suggestions/import" enctype="multipart/form-data" class="admin-form">
    <label>Edited CSV <input type="file" name="csv" accept=".csv,text/csv" required></label>
    <button type="submit">Import</button>
  </form>
  <p class="scorecard-note">In Excel, save as <strong>CSV UTF-8</strong> where offered (plain CSV also works). Scorecards are JSON; edit them on the club page rather than in a cell unless you are confident with the format.</p>
</div>

<% if (importResult === 'ok') { %>
  <p class="success-message">Import complete: <%= importChanged %> club<%= importChanged === '1' ? '' : 's' %> with changes queued for review.</p>
  <% if (importProblems.length) { %>
    <ul class="suggestion-warnings">
      <% importProblems.forEach(function(p) { %><li><%= p %> (cell skipped)</li><% }); %>
    </ul>
  <% } %>
<% } else if (importResult === 'nofile' || importResult === 'badfile') { %>
  <p class="error-message"><%= importResult === 'nofile' ? 'Choose a CSV file first.' : 'That file has no id column, so rows cannot be matched to clubs. Start from an export.' %></p>
<% } %>

<% if (removed) { %><p class="success-message">Club removed. It's hidden from the site and won't be researched again; restore it from Admin &rarr; Clubs if needed.</p><% } %>
<% if (bulk === 'none') { %>
  <p class="error-message">Nothing was ticked, so nothing was applied.</p>
<% } else if (applied !== null) { %>
  <p class="success-message"><% if (bulk) { %>Applied <%= applied %> field<%= applied === '1' ? '' : 's' %> across <%= bulk %> club<%= bulk === '1' ? '' : 's' %>. Clubs with nothing ticked are still below.<% } else { %><%= applied %> field<%= applied === '1' ? '' : 's' %> applied.<% } %></p>
  <% if (applyProblems.length) { %>
    <ul class="suggestion-warnings"><% applyProblems.forEach(function(p) { %><li><%= p %></li><% }); %></ul>
  <% } %>
<% } %>

<p class="course-address">
  Proposed details from <code>scripts/enrich-clubs.js</code>. Every box is editable, including fields that weren't found; typing in a box ticks it, and Apply saves what's in the ticked boxes. Fields that would fill a gap, and your own spreadsheet edits, are ticked;
  researched values that would overwrite existing data are not. Check anything marked with a warning against its source.
  <% if (counts.accepted || counts.rejected) { %>
    <br>Reviewed so far: <%= counts.accepted || 0 %> accepted, <%= counts.rejected || 0 %> rejected.
  <% } %>
</p>

<% if (suggestions.length === 0) { %>
  <p>Nothing waiting for review. Run <code>node scripts/enrich-clubs.js --limit 10</code> to research more clubs.</p>
<% } %>

<%
  const labels = {
    county: 'County', holes: 'Holes', address: 'Address', website: 'Website', opens_url: 'Open competitions page', juniors_url: 'Junior golf page', contact_email: 'Email', facebook_url: 'Facebook',
    instagram_url: 'Instagram', x_url: 'X / Twitter', description: 'Description', par: 'Par',
    yardage: 'Yardage', scorecard: 'Scorecard', logo_url: 'Logo'
  };
  function cardSummary(card) {
    if (!Array.isArray(card) || !card.length) return '';
    const par = card.reduce((s, h) => s + (Number(h.par) || 0), 0);
    const tees = card[0].yards ? Object.keys(card[0].yards) : [];
    return card.length + ' holes, par ' + par + (tees.length ? ', tees: ' + tees.join(', ') : '');
  }
  function isUrl(v) { return typeof v === 'string' && /^https?:\/\//.test(v); }
%>

<% if (suggestions.length) { %>
  <div class="bulk-bar">
    <button type="button" class="bulk-apply-button">Apply all ticked</button>
    <span class="muted small"><span class="bulk-summary"></span> Applies every club's ticked fields in one go, using what's in the boxes. Clubs with nothing ticked stay in the queue.</span>
  </div>
<% } %>

<% suggestions.forEach(function(s) { %>
  <div class="detail-card suggestion-card">
    <h2 style="margin-top:0;"><%= s.club_name %></h2>
    <p class="course-address"><a href="/clubs/<%= s.club_slug %>" target="_blank">Club page</a> · <a href="/admin/clubs/<%= s.club_id %>/edit">Edit club</a> · Researched <%= new Date(s.created_at).toLocaleDateString('en-GB') %></p>

    <% if (s.warnings && s.warnings.length) { %>
      <ul class="suggestion-warnings">
        <% s.warnings.forEach(function(w) { %><li><%= w %></li><% }); %>
      </ul>
    <% } %>

    <form method="post" action="/admin/club-suggestions/<%= s.id %>/apply">
      <div class="scorecard-scroll">
      <table class="admin-table suggestion-table">
        <thead><tr><th>Apply</th><th>Field</th><th>Current</th><th>Proposed (editable)</th><th>Source</th></tr></thead>
        <tbody>
          <% fields.forEach(function(f) { %>
            <% const proposed = s.data[f]; %>
            <% const current = s[f]; %>
            <% const hasCurrent = current != null && current !== '' && !(Array.isArray(current) && !current.length); %>
            <% const hasProposed = proposed != null; %>
            <% const same = hasCurrent && hasProposed && JSON.stringify(current) === JSON.stringify(proposed); %>
            <% const manual = s.sources && s.sources[f] === 'manual'; %>
            <% const ticked = hasProposed && !same && (!hasCurrent || manual); %>
            <% const boxValue = hasProposed ? (f === 'scorecard' ? JSON.stringify(proposed) : proposed) : ''; %>
            <tr class="<%= same ? 'suggestion-same' : '' %> <%= !hasProposed ? 'suggestion-missing' : '' %>">
              <td><input type="checkbox" name="fields" value="<%= f %>" <%= ticked ? 'checked' : '' %>></td>
              <td><%= labels[f] %></td>
              <td class="suggestion-current">
                <% if (!hasCurrent) { %><em>empty</em>
                <% } else if (f === 'scorecard') { %><%= cardSummary(current) %>
                <% } else if (f === 'logo_url') { %><img src="<%= current %>" alt="" class="suggestion-logo">
                <% } else { %><%= current %><% } %>
              </td>
              <td class="suggestion-edit">
                <% if (f === 'scorecard') { %>
                  <% if (hasProposed) { %>
                    <details><summary><%= cardSummary(proposed) %></summary>
                      <%- include('../partials/scorecard', { scorecard: proposed, scorecardNote: null }) %>
                    </details>
                  <% } %>
                  <textarea name="value_scorecard" rows="3" placeholder="JSON list of holes, or import a photo from the club page"><%= boxValue %></textarea>
                <% } else if (f === 'county') { %>
                  <select name="value_county">
                    <option value="">—</option>
                    <% counties.forEach(function(c) { %><option value="<%= c.name %>" <%= boxValue === c.name ? 'selected' : '' %>><%= c.name %></option><% }); %>
                  </select>
                <% } else if (f === 'description') { %>
                  <textarea name="value_description" rows="3" placeholder="Not found — type to add"><%= boxValue %></textarea>
                <% } else if (f === 'par' || f === 'yardage' || f === 'holes') { %>
                  <input type="number" name="value_<%= f %>" value="<%= boxValue %>" placeholder="Not found">
                  <% if (f === 'yardage' && s.sources && s.sources.yardage_tee) { %><span class="scorecard-note"><%= s.sources.yardage_tee %> tees</span><% } %>
                <% } else { %>
                  <% if (f === 'logo_url' && hasProposed) { %><img src="<%= proposed %>" alt="Proposed logo" class="suggestion-logo"><br><% } %>
                  <input type="<%= f === 'contact_email' ? 'email' : 'text' %>" name="value_<%= f %>" value="<%= boxValue %>" placeholder="Not found — type to add">
                  <% if (f === 'address' && s.data.lat != null) { %><span class="scorecard-note">Geocoded: <%= s.data.lat %>, <%= s.data.lng %> (re-checked if you edit the address)</span><% } %>
                  <% if (isUrl(proposed)) { %><a href="<%= proposed %>" target="_blank" class="scorecard-note">open link</a><% } %>
                <% } %>
              </td>
              <td><% if (manual) { %><strong>your edit</strong><% } else if (s.sources && isUrl(s.sources[f])) { %><a href="<%= s.sources[f] %>" target="_blank">source</a><% } else if (hasProposed) { %><span class="scorecard-note">none</span><% } %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
      </div>
      <button type="submit">Apply ticked fields</button>
    </form>
    <div class="suggestion-actions">
      <form method="post" action="/admin/club-suggestions/<%= s.id %>/reject" style="display:inline;">
        <button type="submit" class="admin-delete-button">Reject suggestions</button>
      </form>
      <form method="post" action="/admin/clubs/<%= s.club_id %>/archive" class="suggestion-remove" onsubmit="return confirm('Remove <%= s.club_name.replace(/'/g, '') %> from the site? You can restore it from the club page.');">
        <input type="hidden" name="back" value="suggestions">
        <input type="text" name="reason" placeholder="Reason (optional), e.g. closed 2023">
        <button type="submit" class="admin-delete-button">Remove club</button>
      </form>
    </div>
  </div>
<% }); %>

<% if (suggestions.length) { %>
  <div class="bulk-bar">
    <button type="button" class="bulk-apply-button">Apply all ticked</button>
    <span class="muted small"><span class="bulk-summary"></span></span>
  </div>
  <form id="bulk-apply-form" method="post" action="/admin/club-suggestions/apply-all" style="display:none;">
    <input type="hidden" name="payload" id="bulk-payload">
  </form>
<% } %>

<style>
  .suggestion-card { margin-bottom: 1.5rem; }
  .bulk-bar { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem; margin: 1rem 0 1.5rem; padding: 0.75rem 1rem; background: var(--surface); border: 1px solid var(--border); border-radius: 8px; }
  .bulk-bar .bulk-summary { font-weight: 600; color: var(--text-primary); }
  .suggestion-tools { margin-bottom: 1.5rem; }
  .suggestion-actions { display: flex; flex-wrap: wrap; gap: 1rem; align-items: center; margin-top: 0.75rem; }
  .suggestion-remove { display: flex; gap: 0.5rem; align-items: center; }
  .suggestion-remove input { min-width: 14rem; }
  .suggestion-warnings { background: #fff6e5; border-left: 3px solid #e0a100; padding: 0.5rem 0.5rem 0.5rem 1.75rem; margin: 0.5rem 0 1rem; font-size: 0.9rem; }
  .suggestion-table td { vertical-align: top; }
  .suggestion-current { color: var(--text-secondary); max-width: 16rem; }
  .suggestion-same { opacity: 0.5; }
  .suggestion-edit input, .suggestion-edit textarea { width: 100%; min-width: 16rem; box-sizing: border-box; }
  .suggestion-missing td:nth-child(2) { color: var(--text-secondary); }
  .suggestion-logo { max-height: 48px; max-width: 160px; background: #f4f4f4; padding: 4px; border-radius: 4px; }
</style>

<script>
  // Typing in a box ticks its Apply checkbox
  document.querySelectorAll('.suggestion-edit input, .suggestion-edit textarea, .suggestion-edit select').forEach(function (box) {
    box.addEventListener(box.tagName === 'SELECT' ? 'change' : 'input', function () {
      const row = box.closest('tr');
      const tick = row && row.querySelector('input[type=checkbox][name=fields]');
      if (tick) tick.checked = box.value.trim() !== '';
    });
  });
</script>


<script>
  (function () {
    const applyForms = Array.from(document.querySelectorAll('form[action$="/apply"]'))
      .filter(f => /\/admin\/club-suggestions\/\d+\/apply$/.test(f.getAttribute('action')));

    function gather() {
      const payload = {};
      let clubs = 0, fields = 0;
      applyForms.forEach(function (form) {
        const id = form.getAttribute('action').match(/club-suggestions\/(\d+)\/apply/)[1];
        const ticked = Array.from(form.querySelectorAll('input[type=checkbox][name=fields]:checked')).map(cb => cb.value);
        if (!ticked.length) return;
        const values = {};
        ticked.forEach(function (f) {
          const box = form.querySelector('[name="value_' + f + '"]');
          if (!box) return;
          const original = box.tagName === 'SELECT'
            ? (Array.from(box.options).find(o => o.defaultSelected) || { value: '' }).value
            : box.defaultValue;
          if (box.value !== original) values[f] = box.value;   // edited: send it; otherwise the stored value is used
        });
        payload[id] = { fields: ticked, values: values };
        clubs++; fields += ticked.length;
      });
      return { payload, clubs, fields };
    }

    function refresh() {
      const g = gather();
      document.querySelectorAll('.bulk-summary').forEach(el => {
        el.textContent = g.fields ? g.fields + ' ticked field' + (g.fields === 1 ? '' : 's') + ' across ' + g.clubs + ' club' + (g.clubs === 1 ? '' : 's') + '.' : 'Nothing ticked yet.';
      });
    }

    document.addEventListener('change', function (e) { if (e.target.matches('input[type=checkbox][name=fields], .suggestion-edit select')) refresh(); });
    document.addEventListener('input', function (e) { if (e.target.closest('.suggestion-edit')) setTimeout(refresh, 0); });

    document.querySelectorAll('.bulk-apply-button').forEach(function (btn) {
      btn.addEventListener('click', function () {
        const g = gather();
        if (!g.fields) { alert('Nothing is ticked.'); return; }
        if (!confirm('Apply ' + g.fields + ' ticked field' + (g.fields === 1 ? '' : 's') + ' across ' + g.clubs + ' club' + (g.clubs === 1 ? '' : 's') + '?')) return;
        document.getElementById('bulk-payload').value = JSON.stringify(g.payload);
        btn.disabled = true; btn.textContent = 'Applying...';
        document.getElementById('bulk-apply-form').submit();
      });
    });

    refresh();
  })();
</script>

<%- include('../partials/foot') %>
