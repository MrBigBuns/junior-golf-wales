<!DOCTYPE html>
<html lang="en-GB">
<head>
<meta charset="utf-8">
<meta name="robots" content="noindex">
<title>Golf tip <%= card.number %>: <%= card.title %></title>
<link rel="stylesheet" href="/css/cards.css">
</head>
<body class="card-page size-<%= size %><%= embed ? ' embed' : '' %>">

<%# Shares the Good luck card's sky, hill and lettering (cards.css) %>
<div class="card goodluck-card tip-card">
  <div class="cloud a"></div><div class="cloud b"></div>
  <div class="confetti"><i></i><i></i><i></i><i></i><i></i></div>

  <div class="head">
    <p class="kicker">Wales Junior Golf</p>
    <h1>Golf tip</h1>
    <p class="date"><span class="count"><%= card.audience %></span></p>
    <div class="sticker"><span>Tip</span>#<%= card.number %></div>
  </div>

  <div class="hill">
    <svg class="flag" viewBox="0 0 120 180" aria-hidden="true">
      <ellipse cx="38" cy="168" rx="30" ry="9" fill="#1d3557" opacity=".35"/>
      <rect x="34" y="10" width="8" height="160" rx="4" fill="#fff" stroke="#1d3557" stroke-width="4"/>
      <path d="M42 12 L112 34 L42 60 Z" fill="#e63946" stroke="#1d3557" stroke-width="5" stroke-linejoin="round"/>
    </svg>
    <div class="panel">
      <div class="name <%= card.titleClass %>"><%= card.title %></div>
      <p class="body <%= card.bodyClass %>"><%= card.body %></p>
    </div>
  </div>

  <div class="foot">
    <span>Play well, have fun!</span>
    <b><%= host %></b>
  </div>
</div>

<%- include('_bar') %>
</body>
</html>
