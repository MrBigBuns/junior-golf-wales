<%# Small icons for the event card's details table. Colour and size come from cards.css. %>
<% if (icon === 'age') { %><svg viewBox="0 0 100 100"><circle cx="46" cy="14" r="11" stroke="none"/><path d="M46 30 L42 62 M42 62 L28 98 M42 62 L58 98 M46 36 L66 44 L90 6" fill="none" stroke-width="8.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
<% } else if (icon === 'field') { %><svg viewBox="0 0 100 100" stroke="none"><circle cx="28" cy="16" r="12"/><path d="M11 98 L15 40 Q28 30 41 40 L45 98Z"/><circle cx="72" cy="16" r="12"/><path d="M55 98 L59 40 Q72 30 85 40 L89 98Z"/></svg>
<% } else if (icon === 'format') { %><svg viewBox="0 0 100 100"><rect x="14" y="6" width="72" height="88" rx="8" fill="none" stroke-width="8.5"/><path d="M30 30 H70 M30 50 H70 M30 70 H70" fill="none" stroke-width="8.5" stroke-linecap="round"/></svg>
<% } else if (icon === 'course') { %><svg viewBox="0 0 100 100"><ellipse cx="50" cy="86" rx="44" ry="12" stroke="none"/><path d="M42 84 V6" fill="none" stroke-width="8.5" stroke-linecap="round"/><path d="M42 6 L86 22 L42 40Z" stroke="none"/></svg>
<% } else if (icon === 'fee') { %><svg viewBox="0 0 100 100"><circle cx="50" cy="50" r="44" fill="none" stroke-width="8.5"/><text x="50" y="70" font-size="56" font-weight="800" text-anchor="middle" stroke="none" font-family="Inter, Segoe UI, Arial">£</text></svg>
<% } else if (icon === 'deadline') { %><svg viewBox="0 0 100 100"><rect x="8" y="14" width="84" height="80" rx="9" fill="none" stroke-width="8.5"/><rect x="8" y="14" width="84" height="20" stroke="none"/><path d="M30 4 V20 M70 4 V20" fill="none" stroke-width="8.5" stroke-linecap="round"/><g stroke="none"><circle cx="30" cy="52" r="5.5"/><circle cx="50" cy="52" r="5.5"/><circle cx="70" cy="52" r="5.5"/><circle cx="30" cy="74" r="5.5"/><circle cx="50" cy="74" r="5.5"/><circle cx="70" cy="74" r="5.5"/></g></svg>
<% } %>
