<%- include('../partials/head', { pageTitle: 'Admin — Events' }) %>

<div class="admin-header-row">
  <h1>Events</h1>
  <a class="admin-button" href="/admin/events/new">+ New event</a>
</div>
<p><a href="/admin">&larr; Dashboard</a></p>

<% if (removed !== null) { %>
  <p><strong><%= removed === 0 ? 'No past tentative events to remove.' : 'Removed ' + removed + ' past tentative event' + (removed === 1 ? '' : 's') + '.' %></strong></p>
<% } %>

<% if (removable > 0) { %>
  <form method="post" action="/admin/events/remove-past-tentative" onsubmit="return confirm('Permanently delete <%= removable %> tentative event<%= removable === 1 ? '' : 's' %> with a date in the past? This cannot be undone.');">
    <button type="submit" class="admin-button"><%= 'Remove ' + removable + ' past tentative event' + (removable === 1 ? '' : 's') %></button>
  </form>
<% } %>
<% if (kept > 0) { %>
  <p class="course-address"><%= kept %> past tentative event<%= kept === 1 ? ' has' : 's have' %> an entry form and will not be removed. Delete <%= kept === 1 ? 'it' : 'them' %> individually if you are sure.</p>
<% } %>

<table class="admin-table">
  <thead>
    <tr><th>Title</th><th>Club</th><th>Date</th><th>Status</th><th></th></tr>
  </thead>
  <tbody>
    <% events.forEach(function(e) { %>
      <tr>
        <td><%= e.title %></td>
        <td><%= e.club_name %></td>
        <td><%= new Date(e.date_start).toLocaleDateString('en-GB') %></td>
        <td><span class="status-pill status-<%= e.status %>"><%= e.status %></span></td>
        <td><a href="/admin/events/<%= e.id %>/edit">Edit</a> · <a href="/events/<%= e.slug %>" target="_blank">View</a> · <a href="/admin/social?event=<%= e.id %>#event">Card</a></td>
      </tr>
    <% }); %>
  </tbody>
</table>

<%- include('../partials/foot') %>
