<%# Photos for one course. Included on the club page (main course) and on each other course's page. Needs: club, photos, photoFlash; course is set on a course page. %>
<% const forCourse = (typeof course !== 'undefined' && course && course.id) ? course : null; %>
<% const hasOtherCourses = typeof courses !== 'undefined' && courses && courses.length > 0; %>
<% const label = forCourse ? forCourse.name : (hasOtherCourses ? (club.main_course_name || 'the main course') : null); %>
<section id="photos" class="photo-manager">
  <h2>Photos<%= label ? ': ' + label : '' %></h2>
  <p class="scorecard-note">Add as many as you like. When you make a Club spotlight card you choose which photo it uses, so a few good ones is better than the one that happens to be uploaded.<% if (!forCourse && hasOtherCourses) { %> Photos for the club's other courses are added on each course's page.<% } %></p>

  <% if (photoFlash.added) { %><p class="success-message"><%= photoFlash.added %> photo<%= photoFlash.added === 1 ? '' : 's' %> added.</p><% } %>
  <% if (photoFlash.skipped) { %><p class="error-message"><%= photoFlash.skipped %> file<%= photoFlash.skipped === 1 ? ' was' : 's were' %> skipped: only JPEG, PNG and WebP photos can be added.</p><% } %>
  <% if (photoFlash.removed) { %><p class="success-message">Photo removed.</p><% } %>

  <% if (photos.length) { %>
    <div class="photo-grid">
      <% photos.forEach(function(p) { %>
        <figure class="photo-item">
          <img src="/admin/photos/<%= p.id %>/image" alt="<%= p.caption || 'Course photo' %>" loading="lazy">
          <% if (p.caption) { %><figcaption><%= p.caption %></figcaption><% } %>
          <form method="post" action="/admin/photos/<%= p.id %>/delete" onsubmit="return confirm('Remove this photo? This cannot be undone.');">
            <button type="submit" class="admin-delete-button">Remove</button>
          </form>
        </figure>
      <% }); %>
    </div>
  <% } else { %>
    <p class="scorecard-note">No photos added yet<%= label ? ' for ' + label : '' %>.</p>
  <% } %>

  <form method="post" action="/admin/clubs/<%= club.id %>/photos" enctype="multipart/form-data" class="admin-form">
    <% if (forCourse) { %><input type="hidden" name="course_id" value="<%= forCourse.id %>"><% } %>
    <label>Add photos <span class="muted small">JPEG, PNG or WebP, up to 10 at a time, 10 MB each</span>
      <input type="file" name="photos" accept="image/jpeg,image/png,image/webp" multiple required>
    </label>
    <label>Caption (optional, used for every photo in this upload)
      <input type="text" name="caption" maxlength="120" placeholder="e.g. The 18th green, Autumn 2026">
    </label>
    <button type="submit">Upload photos</button>
  </form>
</section>
