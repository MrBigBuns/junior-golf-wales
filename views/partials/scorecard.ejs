<%# Full scorecard table. Expects `scorecard` (array of holes) and optional `scorecardNote`. %>
<% if (scorecard && scorecard.length) { %>
  <% const frontNine = scorecard.slice(0, 9); %>
  <% const backNine = scorecard.slice(9, 18); %>
  <%
    // Row shading per tee colour; unknown names (e.g. a club's own tee name) get a neutral shade
    const knownTees = ['white', 'yellow', 'red', 'blue', 'black', 'gold', 'orange', 'green', 'purple', 'silver'];
    function teeClass(tee) { const t = String(tee).toLowerCase(); return 'tee-row ' + (knownTees.includes(t) ? 'tee-' + t : 'tee-other'); }
    function teeLabel(tee) { const t = String(tee).toLowerCase(); const name = (t.charAt(0).toUpperCase() + t.slice(1)).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]); return '<span class="tee-dot tee-dot-' + (knownTees.includes(t) ? t : 'other') + '"></span>' + name + ' yds'; }
  %>
  <% const teeTotals = {}; scorecard.forEach(function(h) { Object.keys(h.yards || {}).forEach(function(t) { teeTotals[t] = (teeTotals[t] || 0) + (Number(h.yards[t]) || 0); }); }); %>
  <% const tees = Object.keys(teeTotals).sort(function(a, b) { return teeTotals[b] - teeTotals[a]; }); %>

  <div class="detail-card scorecard-full-width">
    <h3 class="detail-card-heading">Scorecard</h3>
    <% if (typeof scorecardNote !== 'undefined' && scorecardNote) { %><p class="scorecard-note"><%= scorecardNote %></p><% } %>
    <% if (scorecard.length < 18) { %><p class="scorecard-note">Front nine only — back nine not yet added.</p><% } %>

    <p class="scorecard-nine-label">Front nine</p>
    <div class="scorecard-scroll">
    <table class="scorecard-table">
      <thead>
        <tr><th>Hole</th><% frontNine.forEach(function(h) { %><th><%= h.hole %></th><% }); %><th>Out</th></tr>
      </thead>
      <tbody>
        <tr><td>Par</td><% frontNine.forEach(function(h) { %><td><%= h.par %></td><% }); %><td><%= frontNine.reduce((s, h) => s + (h.par || 0), 0) %></td></tr>
        <% if (frontNine[0] && frontNine[0].strokeIndex !== undefined) { %>
        <tr><td>S.I.</td><% frontNine.forEach(function(h) { %><td><%= h.strokeIndex %></td><% }); %><td>—</td></tr>
        <% } %>
        <% if (tees.length) { %>
          <% tees.forEach(function(tee) { %>
            <tr class="<%= teeClass(tee) %>"><td><%- teeLabel(tee) %></td><% frontNine.forEach(function(h) { %><td><%= (h.yards || {})[tee] %></td><% }); %><td><%= frontNine.reduce((s, h) => s + ((h.yards || {})[tee] || 0), 0) %></td></tr>
          <% }); %>
        <% } %>
      </tbody>
    </table>
    </div>

    <% if (backNine.length) { %>
      <p class="scorecard-nine-label">Back nine</p>
      <div class="scorecard-scroll">
      <table class="scorecard-table">
        <thead>
          <tr><th>Hole</th><% backNine.forEach(function(h) { %><th><%= h.hole %></th><% }); %><th>In</th></tr>
        </thead>
        <tbody>
          <tr><td>Par</td><% backNine.forEach(function(h) { %><td><%= h.par %></td><% }); %><td><%= backNine.reduce((s, h) => s + (h.par || 0), 0) %></td></tr>
          <% if (backNine[0] && backNine[0].strokeIndex !== undefined) { %>
          <tr><td>S.I.</td><% backNine.forEach(function(h) { %><td><%= h.strokeIndex %></td><% }); %><td>—</td></tr>
          <% } %>
          <% if (tees.length) { %>
            <% tees.forEach(function(tee) { %>
              <tr class="<%= teeClass(tee) %>"><td><%- teeLabel(tee) %></td><% backNine.forEach(function(h) { %><td><%= (h.yards || {})[tee] %></td><% }); %><td><%= backNine.reduce((s, h) => s + ((h.yards || {})[tee] || 0), 0) %></td></tr>
            <% }); %>
          <% } %>
        </tbody>
      </table>
      </div>

      <div class="scorecard-totals">
        <span>Total par: <strong><%= scorecard.reduce((s, h) => s + (h.par || 0), 0) %></strong></span>
        <% tees.forEach(function(tee) { %>
          <span><%= tee.charAt(0).toUpperCase() + tee.slice(1) %>: <strong><%= scorecard.reduce((s, h) => s + ((h.yards || {})[tee] || 0), 0) %> yds</strong></span>
        <% }); %>
      </div>
    <% } %>
  </div>
<% } %>
