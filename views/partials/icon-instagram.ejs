<% const gid = 'igGrad' + Math.random().toString(36).slice(2, 8); %>
<svg class="social-icon" viewBox="0 0 24 24" aria-hidden="true">
  <defs>
    <linearGradient id="<%= gid %>" x1="0" y1="24" x2="24" y2="0">
      <stop offset="0%" stop-color="#FEDA75"/>
      <stop offset="30%" stop-color="#FA7E1E"/>
      <stop offset="60%" stop-color="#D62976"/>
      <stop offset="100%" stop-color="#4F5BD5"/>
    </linearGradient>
  </defs>
  <rect x="0" y="0" width="24" height="24" rx="6" fill="url(#<%= gid %>)"/>
  <rect x="6" y="6" width="12" height="12" rx="3.5" fill="none" stroke="#fff" stroke-width="1.6"/>
  <circle cx="12" cy="12" r="3.2" fill="none" stroke="#fff" stroke-width="1.6"/>
  <circle cx="16.3" cy="7.7" r="1" fill="#fff"/>
</svg>
