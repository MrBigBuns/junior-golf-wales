<%- include('../partials/head', { pageTitle: 'Upcoming junior golf events in Wales' }) %>

<h1>Upcoming junior golf events</h1>

<form method="get" class="filters">
  <input type="text" name="q" value="<%= q || '' %>" placeholder="Search by event, club, or tour">
  <select name="region" onchange="this.form.submit()">
    <option value="">Any region</option>
    <option value="North" <%= region === 'North' ? 'selected' : '' %>>North Wales</option>
    <option value="Mid" <%= region === 'Mid' ? 'selected' : '' %>>Mid Wales</option>
    <option value="South" <%= region === 'South' ? 'selected' : '' %>>South Wales</option>
  </select>
  <% if (age) { %><input type="hidden" name="age" value="<%= age %>"><% } %>
  <button type="submit">Search</button>
</form>
<% if (age) { %><p class="scorecard-note">Filtered by category: <%= age %> — <a href="/events<%= region ? '?region=' + region : '' %>">clear</a></p><% } %>

<% if (totalCount === 0) { %>
  <p>No upcoming events found. <a href="/submit-event">Submit one?</a></p>
<% } %>

<% ['North', 'Mid', 'South', 'Other'].forEach(function(r) { %>
  <% if (grouped[r] && grouped[r].length) { %>
    <div class="section-header">
      <h2><%= r === 'Other' ? 'Region not set' : r + ' Wales' %></h2>
    </div>
    <div class="event-list">
      <% grouped[r].forEach(function(event) { %>
        <a class="event-card" href="/events/<%= event.slug %>">
          <p class="event-card-title"><%= event.title %></p>
          <p class="event-card-club"><%= event.club_name %></p>
          <p class="event-card-meta">
            <%= new Date(event.date_start).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) %>
          </p>
        </a>
      <% }); %>
    </div>
  <% } %>
<% }); %>

<%- include('../partials/foot') %>
