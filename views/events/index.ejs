<% const place = county ? county : (region ? region + ' Wales' : 'Wales'); %>
<%- include('../partials/head', {
  pageTitle: 'Junior Golf Competitions in ' + place + ' ' + seasonYear + ' — Opens, Tours & Club Events',
  pageDescription: 'Every upcoming junior golf competition in ' + place + ': junior opens, the PING Welsh Junior Tour, Mini Masters and club events for boys and girls of all ages, ' + seasonYear + ' season.'
}) %>

<h1>Junior golf competitions in <%= place %> <%= seasonYear %></h1>
<p class="subtitle">Junior opens, national tours and club competitions for boys and girls<% if (!county) { %> · <a href="/county">Browse by county</a><% } %></p>

<nav class="view-tabs" aria-label="Ways to view events">
  <% tabs.forEach(function(t) { %>
    <a class="view-tab<%= t.active ? ' active' : '' %>" href="<%= t.href %>" rel="nofollow"<%- t.active ? ' aria-current="page"' : '' %>><%= t.label %></a>
  <% }); %>
</nav>

<form method="get" class="event-filters">
  <% if (view !== 'all') { %><input type="hidden" name="view" value="<%= view %>"><% } %>
  <input type="text" name="q" value="<%= q || '' %>" placeholder="Search by event, club, or tour" aria-label="Search by event, club, or tour" class="filter-search">
  <button type="submit" class="filter-submit">Search</button>

  <div class="filter-row">
    <label class="filter-field">From
      <input type="date" name="from" value="<%= from || '' %>">
    </label>
    <label class="filter-field">To
      <input type="date" name="to" value="<%= to || '' %>">
    </label>
    <label class="filter-field filter-age">Age
      <select name="age" onchange="this.form.submit()">
        <option value="">Any age</option>
        <% ageOptions.forEach(function(a) { %><option value="<%= a %>" <%= age === a ? 'selected' : '' %>><%= a %></option><% }); %>
      </select>
    </label>
    <label class="filter-field">Region
      <select name="region" onchange="this.form.submit()">
        <option value="">Any region</option>
        <option value="North" <%= region === 'North' ? 'selected' : '' %>>North Wales</option>
        <option value="Mid" <%= region === 'Mid' ? 'selected' : '' %>>Mid Wales</option>
        <option value="South" <%= region === 'South' ? 'selected' : '' %>>South Wales</option>
      </select>
    </label>
    <label class="filter-field">County
      <select name="county" onchange="this.form.submit()">
        <option value="">Any county</option>
        <% counties.forEach(function(c) { %><option value="<%= c.name %>" <%= county === c.name ? 'selected' : '' %>><%= c.name %></option><% }); %>
      </select>
    </label>
  </div>


  <div class="quick-picks">
    <span class="quick-label">Quick pick</span>
    <% quick.forEach(function(p) { %>
      <a class="quick-pick<%= p.active ? ' active' : '' %>" href="<%= p.href %>" rel="nofollow"><%= p.label %></a>
    <% }); %>
  </div>
</form>

<% if (activeFilters > 0) { %>
  <% const niceDay = function(iso) { return new Date(iso + 'T00:00:00Z').toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' }); };
     const range = from && to ? niceDay(from) + ' to ' + niceDay(to) : (from ? 'from ' + niceDay(from) : (to ? 'up to ' + niceDay(to) : '')); %>
  <div class="filter-status" role="status">
    <span class="filter-status-text"><strong><%= totalCount %></strong> <%= totalCount === 1 ? 'event matches' : 'events match' %><% if (range) { %> · <%= range %><% } %> · <span class="nowrap"><%= activeFilters %> <%= activeFilters === 1 ? 'filter' : 'filters' %> on</span></span>
    <a class="clear-filters" href="<%= clearHref %>" rel="nofollow">
      <svg width="12" height="12" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M2 2l10 10M12 2L2 12"></path></svg>
      Clear filters
    </a>
  </div>
<% } %>


<% if (view === 'open') { %>
  <p class="scorecard-note">Events you can enter now, closing soonest first. Events whose entries have not opened yet are under <a href="/events">All events</a>.</p>
<% } %>

<% if (totalCount === 0) { %>
  <p>No upcoming competitions found<%= county || region || from || to || age || q ? ' for these filters' : '' %>. <a href="/events">See all of Wales</a> or <a href="/submit-event">submit one</a>.</p>
<% } %>

<% const dayText = function(d) { return new Date(d).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }); }; %>

<% if (view === 'open') { %>
  <div class="event-list">
    <% openEvents.forEach(function(event) { %>
      <a class="event-card" href="/events/<%= event.slug %>">
        <% if (event.entry_deadline) { %><p class="event-card-closes">Closes <%= new Date(event.entry_deadline).toLocaleDateString('en-GB', { day: 'numeric', month: 'short' }) %></p><% } %>
        <p class="event-card-title"><%= event.title %></p>
        <p class="event-card-club"><%= event.club_name %></p>
        <p class="event-card-meta"><%= dayText(event.date_start) %></p>
      </a>
    <% }); %>
  </div>
<% } %>

<% if (byTour) { %>
  <% tourGroups.forEach(function(g) { %>
    <div class="section-header">
      <h2><%= g.name %></h2>
      <a href="/tours/<%= g.slug %>">About this tour</a>
    </div>
    <div class="event-list">
      <% g.events.forEach(function(event) { %>
        <a class="event-card" href="/events/<%= event.slug %>">
          <p class="event-card-title"><%= event.title %></p>
          <p class="event-card-club"><%= event.club_name %></p>
          <p class="event-card-meta"><%= dayText(event.date_start) %></p>
        </a>
      <% }); %>
    </div>
  <% }); %>
<% } %>

<% (view === 'all' ? ['North', 'Mid', 'South', 'Other'] : []).forEach(function(r) { %>
  <% if (grouped[r] && grouped[r].length) { %>
    <div class="section-header">
      <h2><%= r === 'Other' ? 'Region not set' : r + ' Wales' %></h2>
    </div>
    <div class="event-list">
      <% grouped[r].forEach(function(event) { %>
        <a class="event-card" href="/events/<%= event.slug %>">
          <p class="event-card-title"><%= event.title %></p>
          <p class="event-card-club"><%= event.club_name %></p>
          <p class="event-card-meta"><%= dayText(event.date_start) %></p>
        </a>
      <% }); %>
    </div>
  <% } %>
<% }); %>

<%- include('../partials/foot') %>
