<%- include('../partials/head', {
  pageTitle: event.title + ' at ' + event.club_name,
  pageDescription: event.meta_description || (event.title + ' at ' + event.club_name + ', ' + event.region + ' Wales — ' + new Date(event.date_start).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' }) + '.'),
  ogImage: event.club_course_image_url || null
}) %>

<nav class="breadcrumb">
  <a href="/events">Events</a> / <span><%= event.club_name %></span>
</nav>

<h1><%= event.title %> <span class="h1-club">at <%= event.club_name %></span></h1>
<p class="subtitle"><%= event.region %> Wales<% if (event.address) { %> · <%= event.address %><% } %></p>
<p><a class="calendar-link" href="/events/<%= event.slug %>/calendar.ics"><i class="cal-icon">&#128197;</i> Add to calendar</a></p>

<div class="event-detail-grid">
  <div>
    <div class="detail-card">
      <h3 class="detail-card-heading">Registration</h3>
      <table class="details-table">
        <% if (event.registration_opens) { %><tr><td>Begins</td><td><%= new Date(event.registration_opens).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) %></td></tr><% } %>
        <% if (event.entry_deadline) { %><tr><td>Entry deadline</td><td><%= new Date(event.entry_deadline).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) %></td></tr><% } %>
        <% if (!event.entry_fee_tiers && event.entry_fee) { %><tr><td>Entry fee</td><td>£<%= event.entry_fee %></td></tr><% } %>
      </table>

      <% if (event.entry_fee_tiers && event.entry_fee_tiers.length) { %>
        <table class="fee-tiers-table">
          <thead><tr><th>Entry fee</th><th></th></tr></thead>
          <tbody>
            <% event.entry_fee_tiers.forEach(function(tier) { %>
              <tr><td><%= tier.label %></td><td>£<%= tier.amount %></td></tr>
            <% }); %>
          </tbody>
        </table>
      <% } %>

      <% if (event.form_id) { %>
        <div class="how-to-enter">
          <a class="enter-button" href="/events/<%= event.slug %>/register">Register for this event</a>
        </div>
      <% } else if (event.entry_url || event.entry_email || event.entry_phone) { %>
        <div class="how-to-enter">
          <% if (event.entry_url) { %>
            <a class="enter-button" href="<%= event.entry_url %>" target="_blank" rel="noopener">Enter this event</a>
          <% } %>
          <% if (event.entry_email) { %>
            <p class="enter-contact"><i>Email:</i> <a href="mailto:<%= event.entry_email %>"><%= event.entry_email %></a></p>
          <% } %>
          <% if (event.entry_phone) { %>
            <p class="enter-contact"><i>Phone:</i> <a href="tel:<%= event.entry_phone.replace(/\s+/g, '') %>"><%= event.entry_phone %></a></p>
          <% } %>
        </div>
      <% } else { %>
        <p class="enter-fallback">No online entry listed yet — contact <%= event.club_name %> directly to enter.</p>
      <% } %>
    </div>

    <% if (updates.length) { %>
      <div class="detail-card">
        <h3 class="detail-card-heading">Latest updates</h3>
        <ul class="updates-list">
          <% updates.forEach(function(u) { %>
            <li>
              <span class="update-date"><%= new Date(u.created_at).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) %></span>
              <span class="update-message"><%= u.message %></span>
            </li>
          <% }); %>
        </ul>
      </div>
    <% } %>

    <div class="detail-card">
      <h3 class="detail-card-heading">Event details</h3>
      <table class="details-table">
        <tr><td>Date</td><td><%= new Date(event.date_start).toLocaleDateString('en-GB', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' }) %></td></tr>
        <% if (event.start_time) { %><tr><td>Start time</td><td><%= event.start_time %></td></tr><% } %>
        <% if (event.format) { %><tr><td>Format</td><td><%= event.format %></td></tr><% } %>
        <% if (event.gender) { %><tr><td>Open to</td><td><%= event.gender %></td></tr><% } %>
        <% if (event.age_category) { %><tr><td>Category</td><td><%= event.age_category %></td></tr><% } %>
        <% if (event.hcp_index_limit) { %><tr><td>Hcp index limit</td><td><%= event.hcp_index_limit %></td></tr><% } %>
        <% if (event.holes) { %><tr><td>Holes</td><td><%= event.holes %><% if (event.par) { %> · Par <%= event.par %><% } %></td></tr><% } %>
        <% if (event.yardage) { %><tr><td>Yardage</td><td><%= event.yardage %> yds<% if (event.junior_tees_note) { %> — <%= event.junior_tees_note %><% } %></td></tr><% } %>
        <% if (event.hcp_allowance_info) { %><tr><td>Handicap allowance</td><td><%= event.hcp_allowance_info %></td></tr><% } %>
        <% if (event.catering) { %><tr><td>Catering</td><td><%= event.catering %></td></tr><% } %>
        <% if (event.prizes) { %><tr><td>Prizes</td><td><%= event.prizes %></td></tr><% } %>
      </table>
    </div>

    <% if (event.scorecard && event.scorecard.length) { %>
      <% const primaryTee = event.scorecard[0].yards ? Object.keys(event.scorecard[0].yards)[0] : null; %>
      <% const byPar = { 3: [], 4: [], 5: [] }; %>
      <% event.scorecard.forEach(function(h) { if (byPar[h.par] && primaryTee && h.yards && h.yards[primaryTee] != null) byPar[h.par].push(h.yards[primaryTee]); }); %>
      <div class="detail-card">
        <h3 class="detail-card-heading">Course stats</h3>
        <div class="course-stats-summary">
          <div><span class="stat-value"><%= event.par || '' %></span><span class="stat-label">par</span></div>
          <div><span class="stat-value"><%= event.yardage || '' %></span><span class="stat-label">yards<% if (primaryTee) { %> (<%= primaryTee %>)<% } %></span></div>
        </div>
        <% [3, 4, 5].forEach(function(p) { %>
          <% const yds = byPar[p]; %>
          <% if (yds.length) { %>
            <% const short = Math.min(...yds); %>
            <% const long = Math.max(...yds); %>
            <% const avg = Math.round(yds.reduce((a, b) => a + b, 0) / yds.length); %>
            <% const pos = long > short ? Math.round(((avg - short) / (long - short)) * 100) : 50; %>
            <div class="par-stat-row">
              <p class="par-stat-label">Par <%= p %> <span class="par-stat-count"><%= yds.length %> total</span></p>
              <div class="par-stat-track"><span class="par-stat-marker" style="left: <%= pos %>%"></span></div>
              <div class="par-stat-endpoints">
                <span>Short<br><strong><%= short %></strong></span>
                <span class="par-stat-avg">Avg<br><strong><%= avg %></strong></span>
                <span class="par-stat-long">Long<br><strong><%= long %></strong></span>
              </div>
            </div>
          <% } %>
        <% }); %>
      </div>
    <% } %>

    <% if (otherAtClub.length) { %>
      <h2>Other events at this club</h2>
      <ul class="related-list">
        <% otherAtClub.forEach(function(e) { %>
          <li><a href="/events/<%= e.slug %>"><%= e.title %> — <%= new Date(e.date_start).toLocaleDateString('en-GB') %></a></li>
        <% }); %>
      </ul>
    <% } %>
  </div>

  <div>
    <div class="detail-card course-card">
      <h3 class="detail-card-heading">Course</h3>
      <% const hasBanner = event.club_has_course_photo || event.club_course_image_url; %>
      <% const hasLogo = event.club_has_logo_image; %>
      <% if (hasBanner) { %>
        <div class="club-banner-wrap club-banner-wrap-small">
          <img class="club-banner-image club-banner-image-small" src="<%= event.club_has_course_photo ? '/clubs/' + event.club_id + '/course-photo-image' : event.club_course_image_url %>" alt="<%= event.club_name %>">
          <% if (hasLogo) { %>
            <img class="club-banner-logo club-banner-logo-small" src="/clubs/<%= event.club_id %>/logo-image" alt="<%= event.club_name %> logo">
          <% } %>
        </div>
      <% } %>
      <p class="course-club-name <%= hasBanner && hasLogo ? 'has-overlapping-logo-small' : '' %>">
        <% if (!hasBanner && hasLogo) { %><img src="/clubs/<%= event.club_id %>/logo-image" alt="<%= event.club_name %> logo" class="club-logo-inline"> <% } %>
        <%= event.club_name %>
      </p>
      <% if (event.address) { %><p class="course-address"><%= event.address %></p><% } %>
      <% if (event.club_description) { %><p class="course-description"><%= event.club_description %></p><% } %>
      <div class="course-links">
        <% if (event.club_website) { %><a href="<%= event.club_website %>" target="_blank" rel="noopener">Club website</a><% } %>
        <% if (event.directions_url) { %><a href="<%= event.directions_url %>" target="_blank" rel="noopener">Directions</a><% } %>
        <a href="/clubs/<%= event.club_slug %>">Club page</a>
      </div>
      <% if (event.club_facebook_url || event.club_instagram_url || event.club_x_url) { %>
        <div class="social-links">
          <% if (event.club_facebook_url) { %><a href="<%= event.club_facebook_url %>" target="_blank" rel="noopener" aria-label="Facebook"><%- include('../partials/icon-facebook') %></a><% } %>
          <% if (event.club_instagram_url) { %><a href="<%= event.club_instagram_url %>" target="_blank" rel="noopener" aria-label="Instagram"><%- include('../partials/icon-instagram') %></a><% } %>
          <% if (event.club_x_url) { %><a href="<%= event.club_x_url %>" target="_blank" rel="noopener" aria-label="X"><%- include('../partials/icon-x') %></a><% } %>
        </div>
      <% } %>
    </div>

    <% if (event.address) { %>
      <div class="detail-card">
        <h3 class="detail-card-heading">Event location</h3>
        <iframe
          class="map-embed"
          loading="lazy"
          src="https://www.google.com/maps?q=<%= encodeURIComponent(event.club_name + ', ' + event.address) %>&output=embed">
        </iframe>
      </div>
    <% } %>

    <% if (event.weather) { %>
      <div class="detail-card">
        <h3 class="detail-card-heading">Event day weather</h3>
        <div class="weather-row">
          <span class="weather-temp"><%= event.weather.maxTemp %>&deg;<span class="weather-temp-low"> / <%= event.weather.minTemp %>&deg;</span></span>
        </div>
        <p class="weather-detail"><%= event.weather.rainChance %>% chance of rain · wind up to <%= event.weather.windSpeed %> km/h</p>
      </div>
    <% } else if (event.weatherPending) { %>
      <div class="detail-card">
        <h3 class="detail-card-heading">Event day weather</h3>
        <p class="scorecard-note">Forecast becomes available around 2 weeks before the event.</p>
      </div>
    <% } %>

    <% if (event.nearby_hotels_url || event.nearby_things_url) { %>
      <div class="detail-card">
        <h3 class="detail-card-heading">Nearby</h3>
        <div class="course-links">
          <% if (event.nearby_hotels_url) { %><a href="<%= event.nearby_hotels_url %>" target="_blank" rel="noopener">Accommodation nearby</a><% } %>
          <% if (event.nearby_things_url) { %><a href="<%= event.nearby_things_url %>" target="_blank" rel="noopener">Things to do nearby</a><% } %>
        </div>
      </div>
    <% } %>

    <% if (event.organiser_name) { %>
      <div class="detail-card">
        <h3 class="detail-card-heading">Part of</h3>
        <p class="tour-name"><%= event.organiser_name %></p>
        <% if (event.organiser_description) { %><p class="tour-desc"><%= event.organiser_description %></p><% } %>
        <a href="/tours/<%= event.organiser_slug %>">View series</a>
      </div>
    <% } %>
  </div>
</div>

<% if (event.scorecard && event.scorecard.length) { %>
  <% const frontNine = event.scorecard.slice(0, 9); %>
  <% const backNine = event.scorecard.slice(9, 18); %>
  <% const teeColors = { white: 'tee-white', yellow: 'tee-yellow', red: 'tee-red', blue: 'tee-blue' }; %>

  <div class="detail-card scorecard-full-width">
    <h3 class="detail-card-heading">Scorecard</h3>
    <% if (event.scorecard.length < 18) { %><p class="scorecard-note">Front nine only — back nine not yet added.</p><% } %>

    <p class="scorecard-nine-label">Front nine</p>
    <div class="scorecard-scroll">
    <table class="scorecard-table">
      <thead>
        <tr><th>Hole</th><% frontNine.forEach(function(h) { %><th><%= h.hole %></th><% }); %><th>Out</th></tr>
      </thead>
      <tbody>
        <tr><td>Par</td><% frontNine.forEach(function(h) { %><td><%= h.par %></td><% }); %><td><%= frontNine.reduce((s, h) => s + (h.par || 0), 0) %></td></tr>
        <% if (frontNine[0] && frontNine[0].strokeIndex !== undefined) { %>
        <tr><td>S.I.</td><% frontNine.forEach(function(h) { %><td><%= h.strokeIndex %></td><% }); %><td>—</td></tr>
        <% } %>
        <% if (frontNine[0] && frontNine[0].yards) { %>
          <% Object.keys(frontNine[0].yards).forEach(function(tee) { %>
            <tr class="<%= teeColors[tee] || '' %>"><td><%= tee.charAt(0).toUpperCase() + tee.slice(1) %> yds</td><% frontNine.forEach(function(h) { %><td><%= h.yards[tee] %></td><% }); %><td><%= frontNine.reduce((s, h) => s + (h.yards[tee] || 0), 0) %></td></tr>
          <% }); %>
        <% } %>
      </tbody>
    </table>
    </div>

    <% if (backNine.length) { %>
      <p class="scorecard-nine-label">Back nine</p>
      <div class="scorecard-scroll">
      <table class="scorecard-table">
        <thead>
          <tr><th>Hole</th><% backNine.forEach(function(h) { %><th><%= h.hole %></th><% }); %><th>In</th></tr>
        </thead>
        <tbody>
          <tr><td>Par</td><% backNine.forEach(function(h) { %><td><%= h.par %></td><% }); %><td><%= backNine.reduce((s, h) => s + (h.par || 0), 0) %></td></tr>
          <% if (backNine[0] && backNine[0].strokeIndex !== undefined) { %>
          <tr><td>S.I.</td><% backNine.forEach(function(h) { %><td><%= h.strokeIndex %></td><% }); %><td>—</td></tr>
          <% } %>
          <% if (backNine[0] && backNine[0].yards) { %>
            <% Object.keys(backNine[0].yards).forEach(function(tee) { %>
              <tr class="<%= teeColors[tee] || '' %>"><td><%= tee.charAt(0).toUpperCase() + tee.slice(1) %> yds</td><% backNine.forEach(function(h) { %><td><%= h.yards[tee] %></td><% }); %><td><%= backNine.reduce((s, h) => s + (h.yards[tee] || 0), 0) %></td></tr>
            <% }); %>
          <% } %>
        </tbody>
      </table>
      </div>

      <div class="scorecard-totals">
        <span>Total par: <strong><%= event.scorecard.reduce((s, h) => s + (h.par || 0), 0) %></strong></span>
        <% Object.keys(event.scorecard[0].yards).forEach(function(tee) { %>
          <span><%= tee.charAt(0).toUpperCase() + tee.slice(1) %>: <strong><%= event.scorecard.reduce((s, h) => s + (h.yards[tee] || 0), 0) %> yds</strong></span>
        <% }); %>
      </div>
    <% } %>
  </div>
<% } %>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "SportsEvent",
  "name": "<%= event.title %>",
  "startDate": "<%= event.date_start %>",
  "location": {
    "@type": "Place",
    "name": "<%= event.club_name %>",
    "address": "<%= event.address || '' %>"
  }
}
</script>

<%- include('../partials/foot') %>
