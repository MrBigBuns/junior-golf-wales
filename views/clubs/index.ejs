<%- include('../partials/head', {
  pageTitle: 'Golf Clubs in Wales — Course Details, Scorecards & Junior Opens',
  pageDescription: 'A guide to golf clubs across Wales: addresses, maps, course details, scorecards and upcoming junior golf competitions, by region and county.'
}) %>

<h1>Golf clubs in Wales</h1>
<p class="subtitle">Course details, scorecards, contacts and upcoming junior competitions. Browse by county:
  <% counties.forEach(function(c, i) { %><a href="/county/<%= c.slug %>"><%= c.name %></a><%= i < counties.length - 1 ? ' · ' : '' %><% }); %>
</p>

<% ['North', 'Mid', 'South', 'Other'].forEach(function(region) { %>
  <% if (grouped[region] && grouped[region].length) { %>
    <div class="section-header">
      <h2><%= region === 'Other' ? 'Region not set' : region + ' Wales' %></h2>
    </div>
    <div class="event-list">
      <% grouped[region].forEach(function(c) { %>
        <a class="event-card" href="/clubs/<%= c.slug %>">
          <p class="event-card-title"><%= c.name %></p>
          <p class="event-card-meta"><% if (c.county) { %><%= c.county %> · <% } %><%= c.upcoming_count %> upcoming event<%= c.upcoming_count == 1 ? '' : 's' %></p>
        </a>
      <% }); %>
    </div>
  <% } %>
<% }); %>

<%- include('../partials/foot') %>
