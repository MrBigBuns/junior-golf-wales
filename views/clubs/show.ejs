<%- include('../partials/head', { pageTitle: club.name + ' — junior golf events' }) %>

<% const hasBanner = club.has_course_photo_image || club.course_image_url; %>
<% const hasLogo = club.has_logo_image; %>

<% if (hasBanner) { %>
  <div class="club-banner-wrap">
    <img class="club-banner-image" src="<%= club.has_course_photo_image ? '/clubs/' + club.id + '/course-photo-image' : club.course_image_url %>" alt="<%= club.name %>">
    <% if (hasLogo) { %>
      <img class="club-banner-logo" src="/clubs/<%= club.id %>/logo-image" alt="<%= club.name %> logo">
    <% } %>
  </div>
<% } %>

<div class="club-header-info <%= hasBanner && hasLogo ? 'has-overlapping-logo' : '' %>">
  <% if (!hasBanner && hasLogo) { %>
    <div style="display:flex;align-items:center;gap:10px;">
      <img src="/clubs/<%= club.id %>/logo-image" alt="<%= club.name %> logo" class="club-logo-inline">
      <h1><%= club.name %></h1>
    </div>
  <% } else { %>
    <h1><%= club.name %></h1>
  <% } %>
  <p class="subtitle"><%= club.region %> Wales<% if (club.address) { %> · <%= club.address %><% } %></p>
</div>

<% if (club.website) { %><p><a href="<%= club.website %>" target="_blank" rel="noopener">Club website</a></p><% } %>
<% if (club.facebook_url || club.instagram_url || club.x_url) { %>
  <div class="social-links">
    <% if (club.facebook_url) { %><a href="<%= club.facebook_url %>" target="_blank" rel="noopener" aria-label="Facebook"><%- include('../partials/icon-facebook') %></a><% } %>
    <% if (club.instagram_url) { %><a href="<%= club.instagram_url %>" target="_blank" rel="noopener" aria-label="Instagram"><%- include('../partials/icon-instagram') %></a><% } %>
    <% if (club.x_url) { %><a href="<%= club.x_url %>" target="_blank" rel="noopener" aria-label="X"><%- include('../partials/icon-x') %></a><% } %>
  </div>
<% } %>

<h2>Upcoming junior events</h2>
<% if (events.length === 0) { %>
  <p>No upcoming junior events listed for this club yet.</p>
<% } %>
<ul class="related-list">
  <% events.forEach(function(e) { %>
    <li><a href="/events/<%= e.slug %>"><%= e.title %> — <%= new Date(e.date_start).toLocaleDateString('en-GB') %></a></li>
  <% }); %>
</ul>

<%- include('../partials/foot') %>
