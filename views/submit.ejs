<%- include('partials/head', { pageTitle: 'Submit a junior golf event' }) %>

<h1>Submit a junior golf event</h1>

<% if (submitted) { %>
  <p class="success-message">Thanks — your event has been submitted and will be reviewed shortly.</p>
<% } else { %>
  <% if (typeof error !== 'undefined' && error) { %>
    <p class="error-message"><%= error %></p>
  <% } %>
  <form method="post" class="submit-form">
    <label>Event name
      <input type="text" name="event_title" required>
    </label>
    <label>Club
      <input type="text" name="club_name" required>
    </label>
    <label>Date
      <input type="date" name="event_date" required>
    </label>
    <label>Entry fee (£, leave blank if TBC)
      <input type="text" name="entry_fee">
    </label>
    <label>Your email
      <input type="email" name="contact_email" required>
    </label>
    <label>Notes (format, age category, anything else)
      <textarea name="notes" rows="4"></textarea>
    </label>
    <button type="submit">Submit event</button>
  </form>
<% } %>

<%- include('partials/foot') %>
