<%- include('partials/head', { pageTitle: 'Map of junior golf events — Junior Golf Wales', pageDescription: 'See every upcoming junior golf event in Wales plotted on a map.' }) %>

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="">

<h1>Events map</h1>
<p class="subtitle">Every upcoming junior event we have a location for, in one view.</p>

<div id="events-map" style="height: 520px; border-radius: 12px; margin: 1rem 0;"></div>

<% if (missingCount > 0) { %>
  <p class="scorecard-note"><%= missingCount %> upcoming event<%= missingCount == 1 ? '' : 's' %> not shown — club location not yet set.</p>
<% } %>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
<script>
  const events = <%- JSON.stringify(events) %>;
  const map = L.map('events-map').setView([52.3, -3.7], 8); // roughly centred on Wales

  L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
    attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
    maxZoom: 18
  }).addTo(map);

  if (events.length) {
    const bounds = [];
    events.forEach(function(e) {
      const marker = L.marker([e.lat, e.lng]).addTo(map);
      const dateStr = new Date(e.date_start).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
      marker.bindPopup(
        '<strong>' + e.title + '</strong><br>' + e.club_name + '<br>' + dateStr +
        '<br><a href="/events/' + e.slug + '">View event &rarr;</a>'
      );
      bounds.push([e.lat, e.lng]);
    });
    if (bounds.length > 1) map.fitBounds(bounds, { padding: [30, 30] });
    else if (bounds.length === 1) map.setView(bounds[0], 11);
  }
</script>

<%- include('partials/foot') %>
