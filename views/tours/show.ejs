<%- include('../partials/head', {
  pageTitle: organiser.name + ' ' + seasonYear + ' — Dates, Venues & Entry',
  pageDescription: organiser.name + ' ' + seasonYear + ': upcoming dates and venues' + (events.length ? ' (' + events.length + ' listed)' : '') + ', plus how the series works. ' + (organiser.description ? organiser.description.slice(0, 90) : '')
}) %>

<h1><%= organiser.name %> <%= seasonYear %></h1>
<% if (organiser.description) { %><p class="subtitle"><%= organiser.description %></p><% } %>
<% if (organiser.website) { %><p><a href="<%= organiser.website %>" target="_blank" rel="noopener">Official site</a></p><% } %>

<h2>Upcoming dates and venues</h2>
<% if (events.length === 0) { %>
  <p>No upcoming events listed for this tour yet.</p>
<% } %>
<ul class="related-list">
  <% events.forEach(function(e) { %>
    <li><a href="/events/<%= e.slug %>"><%= e.title %> — <%= e.club_name %> — <%= new Date(e.date_start).toLocaleDateString('en-GB') %></a></li>
  <% }); %>
</ul>

<%- include('../partials/foot') %>
